---
import '../styles/buttons.css';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/hauxon-favicon.png?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Hauxon manufactures quality office seating for global brands, wholesalers and project partners." />
		<title>Hauxon | OEM &amp; ODM Seating Manufacturer</title>
	</head>
	<body>
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
		background: #fff;
		color: #252b27;
	}

	body {
		min-height: 100vh;
	}

	button,
	input,
	select,
	textarea {
		font-family: inherit;
	}
</style>
