---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Factory | Hauxon Furniture">
	<Header />
	<main class="route-placeholder">
		<div>
			<p>Hauxon Manufacturing</p>
			<h1>Our Factory</h1>
			<p>Factory information is being prepared. Please contact our team to arrange a visit.</p>
			<a href="/contact">Contact Us <span aria-hidden="true">→</span></a>
		</div>
	</main>
</Layout>

<style>
	.route-placeholder {
		min-height: 52vh;
		padding: 72px 24px;
		display: grid;
		place-items: center;
		background: #f4f7fb;
		color: #111827;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
		text-align: center;
	}

	.route-placeholder > div {
		max-width: 640px;
	}

	.route-placeholder p:first-child {
		margin: 0 0 12px;
		color: #0b2d5c;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1.4px;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(36px, 4vw, 52px);
		font-weight: 600;
		letter-spacing: -0.035em;
	}

	h1 + p {
		margin: 16px 0 0;
		color: #64748b;
		font-size: 16px;
		line-height: 1.65;
	}

	a {
		min-height: 44px;
		margin-top: 24px;
		padding: 0 18px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border-radius: 5px;
		background: #0b2d5c;
		color: #fff;
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
	}
</style>
