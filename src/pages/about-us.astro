---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const journey = [
	{
		eyebrow: 'The beginning',
		date: '2009',
		title: 'Where It All Began',
		description: 'Hauxon started by manufacturing inner support components for office chairs.',
		image: '/images/about/history-components-opt.webp',
		imageAlt: 'Chair component manufacturing at Hauxon',
		imageLabel: 'Chair components',
	},
	{
		eyebrow: 'Capability growth',
		date: 'Step by step',
		title: 'Expanding Our Expertise',
		description: 'Gradually expanded into PU components, molded foam, and injection molding.',
	},
	{
		eyebrow: 'A new chapter',
		date: '2017',
		title: 'Complete Chair Manufacturing',
		description: 'Expanded from component manufacturing into complete chair production and OEM/ODM seating solutions.',
		image: '/images/about/history-chair-production.jpg',
		imageAlt: 'Chair production at Hauxon',
		imageLabel: 'Chair production',
	},
	{
		eyebrow: 'Connecting internationally',
		date: 'June 2023',
		title: 'Cologne, Germany',
		description: 'Participated in an international furniture exhibition in Cologne, Germany.',
		image: '/images/about/exhibition-cologne-2023-opt.webp',
		imageAlt: 'Hauxon at an international furniture exhibition in Cologne',
		imageLabel: 'Cologne exhibition',
	},
	{
		eyebrow: 'Continuing the journey',
		date: 'September 2026',
		title: 'São Paulo, Brazil',
		description: 'Participated in a furniture exhibition in São Paulo, Brazil.',
		image: '/images/about/exhibition-brazil-2026-opt.webp',
		imageAlt: 'Hauxon at a furniture exhibition in São Paulo',
		imageLabel: 'São Paulo exhibition',
	},
];
---

<Layout
	title="About Us | Hauxon Furniture"
	description="Discover how Anji Huaxuan Furniture Co., Ltd. grew from chair component manufacturing into an OEM and ODM seating partner."
>
	<Header />
	<main class="about-page">
		<section class="story-section" aria-labelledby="story-title">
			<div class="about-container story-layout">
				<div class="story-copy">
					<p class="about-eyebrow">About Hauxon</p>
					<h1 id="story-title">Built Step by Step, <span>Since 2009.</span></h1>
					<p class="story-lead">
						Founded in 2009 in Anji, China, Hauxon began with the manufacturing of chair inner support components.
					</p>
					<p class="story-detail">
						Over the years, we gradually expanded our capabilities into PU components, molded foam, injection molding, and complete chair manufacturing.
					</p>
					<p class="story-detail">
						Today, we provide OEM and ODM seating solutions to customers worldwide, building on the manufacturing experience and expertise developed throughout our journey.
					</p>

					<dl class="company-facts" aria-label="Company facts">
						<div>
							<dt>Since 2009</dt>
							<dd>Growing through experience</dd>
						</div>
						<div>
							<dt>15,000㎡</dt>
							<dd>Manufacturing facility</dd>
						</div>
						<div>
							<dt>300+</dt>
							<dd>Molds</dd>
						</div>
					</dl>
				</div>

				<figure class="image-frame story-image" data-about-image>
					<img
						src="/images/about/about-company.jpg"
						alt=""
						width="1200"
						height="1400"
						loading="eager"
						decoding="async"
					/>
					<div class="image-placeholder" aria-hidden="true">
						<span class="placeholder-label">Company photograph</span>
						<span class="placeholder-note">Anji, China</span>
					</div>
					<figcaption>Anji Huaxuan Furniture Co., Ltd.</figcaption>
				</figure>
			</div>
		</section>

		<section class="journey-section" aria-labelledby="journey-title">
			<div class="about-container">
				<header class="section-intro">
					<p class="about-eyebrow">Our Journey</p>
					<h2 id="journey-title">Progress Built on Experience.</h2>
					<p>Each step has grown from the work and knowledge that came before it.</p>
				</header>

				<ol class="journey-list">
					{journey.map((milestone, index) => (
						<li class:list={['journey-item', { 'is-reversed': index % 2 === 1 }]}>
							<div class="journey-marker" aria-hidden="true">
								<span>{String(index + 1).padStart(2, '0')}</span>
							</div>
							<div class="journey-copy">
								<p class="journey-eyebrow">{milestone.eyebrow}</p>
								<p class="journey-date">{milestone.date}</p>
								<h3>{milestone.title}</h3>
								<p class="journey-description">{milestone.description}</p>
							</div>
							<figure class="image-frame journey-image" data-about-image={milestone.image ? '' : undefined}>
								{milestone.image && (
									<img
										src={milestone.image}
										alt=""
										width="960"
										height="720"
										loading="lazy"
										decoding="async"
									/>
								)}
								<div class="image-placeholder" aria-hidden="true">
									<span class="placeholder-label">{milestone.imageLabel ?? milestone.title}</span>
									<span class="placeholder-note">Photograph to be added</span>
								</div>
								{milestone.imageAlt && <figcaption>{milestone.imageAlt}</figcaption>}
							</figure>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section class="belief-section" aria-labelledby="belief-title">
			<div class="about-container belief-inner">
				<div class="belief-heading">
					<p class="about-eyebrow">What We Believe</p>
					<h2 id="belief-title">Small but<br />Exquisite.</h2>
				</div>
				<div class="belief-copy">
					<p>
						We believe that good manufacturing is built through experience, consistency, and attention to detail.
					</p>
					<p>
						Rather than pursuing scale alone, we focus on refining our capabilities, improving our products, and building lasting partnerships with our customers.
					</p>
				</div>
			</div>
		</section>

		<section class="borders-section" aria-labelledby="borders-title">
			<div class="about-container">
				<header class="section-intro borders-intro">
					<p class="about-eyebrow">Growing Beyond Borders</p>
					<h2 id="borders-title">From Anji to the World.</h2>
					<p>
						From our manufacturing roots in Anji to international exhibitions in Cologne and São Paulo, we continue to explore opportunities to connect with partners around the world.
					</p>
					<p>
						We value direct communication, practical solutions, and long-term relationships with brands, importers, and distributors.
					</p>
				</header>

				<div class="exhibition-gallery">
					<figure class="image-frame exhibition-image" data-about-image>
						<img
							src="/images/about/exhibition-cologne-2023-opt.webp"
							alt=""
							width="1200"
							height="800"
							loading="lazy"
							decoding="async"
						/>
						<div class="image-placeholder" aria-hidden="true">
							<span class="placeholder-label">Exhibition photograph</span>
							<span class="placeholder-note">Photograph to be added</span>
						</div>
						<figcaption>
							<span>Cologne, Germany</span>
							<time datetime="2023-06">June 2023</time>
						</figcaption>
					</figure>
					<figure class="image-frame exhibition-image" data-about-image>
						<img
							src="/images/about/exhibition-brazil-2026-opt.webp"
							alt=""
							width="1200"
							height="800"
							loading="lazy"
							decoding="async"
						/>
						<div class="image-placeholder" aria-hidden="true">
							<span class="placeholder-label">Exhibition photograph</span>
							<span class="placeholder-note">Photograph to be added</span>
						</div>
						<figcaption>
							<span>São Paulo, Brazil</span>
							<time datetime="2026-09">September 2026</time>
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<section class="contact-cta" aria-labelledby="contact-cta-title">
			<div class="about-container contact-cta-inner">
				<div>
					<p class="about-eyebrow">Start a Conversation</p>
					<h2 id="contact-cta-title">Let’s Build Something Together.</h2>
					<p>
						Looking for a reliable seating manufacturing partner? We’d be happy to learn more about your business and explore how we can work together.
					</p>
				</div>
				<a class="hauxon-button contact-cta-button" href="/contact">
					Contact Us <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	document.querySelectorAll<HTMLImageElement>('[data-about-image] img').forEach((image) => {
		const markImageLoaded = () => {
			image.closest('[data-about-image]')?.classList.add('is-loaded');
		};

		if (image.complete && image.naturalWidth > 0) {
			markImageLoaded();
		} else {
			image.addEventListener('load', markImageLoaded, { once: true });
		}
	});
</script>

<style>
	.about-page {
		--about-navy: #0b2d5c;
		--about-ink: #111e32;
		--about-muted: #64748b;
		--about-line: #dce4ed;
		color: #111827;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.about-container {
		width: min(calc(100% - 64px), 1280px);
		margin-inline: auto;
	}

	.about-eyebrow {
		margin: 0 0 14px;
		color: var(--about-navy);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1.4px;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.story-section {
		padding: 76px 0 82px;
		background: #f4f7fb;
	}

	.story-layout {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: clamp(48px, 8vw, 112px);
	}

	.story-copy h1 {
		max-width: 580px;
		margin: 0;
		color: var(--about-ink);
		font-size: clamp(42px, 5vw, 66px);
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1.06;
	}

	.story-copy h1 span {
		color: var(--about-navy);
	}

	.story-lead {
		margin: 26px 0 0;
		color: #34445a;
		font-size: 18px;
		line-height: 1.65;
	}

	.story-detail {
		margin: 14px 0 0;
		color: var(--about-muted);
		font-size: 15px;
		line-height: 1.75;
	}

	.company-facts {
		margin: 36px 0 0;
		padding: 22px 0 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid #d5deea;
	}

	.company-facts > div {
		min-width: 0;
		padding: 0 16px;
		border-left: 1px solid #d5deea;
	}

	.company-facts > div:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.company-facts dt {
		color: var(--about-navy);
		font-size: clamp(20px, 2vw, 27px);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.2;
		white-space: nowrap;
	}

	.company-facts dd {
		margin: 7px 0 0;
		color: var(--about-muted);
		font-size: 12px;
		line-height: 1.5;
	}

	.image-frame {
		position: relative;
		overflow: hidden;
		margin: 0;
		border: 1px solid #dce4ed;
		border-radius: 5px;
		background: #e8edf3;
	}

	.image-frame > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.image-frame.is-loaded > img {
		opacity: 1;
	}

	.image-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 7px;
		background: linear-gradient(145deg, #edf1f5, #e1e8ef);
		color: #52657b;
		text-align: center;
		transition: opacity 180ms ease;
	}

	.image-frame.is-loaded .image-placeholder {
		opacity: 0;
	}

	.placeholder-label {
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
	}

	.placeholder-note {
		color: #718196;
		font-size: 11px;
		line-height: 1.4;
	}

	.image-frame figcaption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 1;
		padding: 34px 16px 13px;
		background: linear-gradient(transparent, rgb(17 30 50 / 48%));
		color: #fff;
		font-size: 12px;
		line-height: 1.45;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.image-frame.is-loaded figcaption {
		opacity: 1;
	}

	.story-image {
		min-height: 560px;
		aspect-ratio: 6 / 7;
	}

	.journey-section {
		padding: 96px 0 104px;
		background: #fff;
	}

	.section-intro {
		max-width: 760px;
		margin-bottom: 56px;
	}

	.section-intro h2 {
		margin: 0;
		color: var(--about-ink);
		font-size: clamp(34px, 4vw, 50px);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.12;
	}

	.section-intro > p:last-child {
		margin: 15px 0 0;
		color: var(--about-muted);
		font-size: 16px;
		line-height: 1.7;
	}

	.journey-list {
		position: relative;
		width: min(100%, 1200px);
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.journey-list::before {
		position: absolute;
		top: 8px;
		bottom: 8px;
		left: 50%;
		width: 1px;
		background: var(--about-line);
		content: '';
		transform: translateX(-50%);
	}

	.journey-item {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1fr);
		align-items: center;
		gap: 0;
		padding: 0 0 48px;
	}

	.journey-item:last-child {
		padding-bottom: 0;
	}

	.journey-marker {
		grid-column: 2;
		grid-row: 1;
		justify-self: center;
		z-index: 1;
		width: 17px;
		height: 17px;
		display: grid;
		place-items: center;
		border: 1px solid #9aacc0;
		border-radius: 50%;
		background: #fff;
	}

	.journey-marker span {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--about-navy);
		font-size: 0;
	}

	.journey-copy,
	.journey-image {
		min-width: 0;
	}

	.journey-copy {
		grid-column: 1;
		grid-row: 1;
		padding-right: 28px;
	}

	.journey-item.is-reversed .journey-copy {
		grid-column: 3;
		padding-right: 0;
		padding-left: 28px;
	}

	.journey-eyebrow {
		margin: 0 0 8px;
		color: #8092a7;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.1px;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.journey-date {
		margin: 0;
		color: var(--about-navy);
		font-size: clamp(24px, 3vw, 35px);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.2;
	}

	.journey-copy h3 {
		margin: 10px 0 0;
		color: var(--about-ink);
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.35;
	}

	.journey-description {
		max-width: 560px;
		margin: 9px 0 0;
		color: var(--about-muted);
		font-size: 14px;
		line-height: 1.7;
	}

	.journey-image {
		grid-column: 3;
		grid-row: 1;
		width: 100%;
		aspect-ratio: 4 / 3;
	}

	.journey-item.is-reversed .journey-image {
		grid-column: 1;
	}

	.belief-section {
		padding: 92px 0 98px;
		background: #102b4d;
		color: #fff;
	}

	.belief-inner {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: clamp(48px, 10vw, 140px);
	}

	.belief-section .about-eyebrow {
		color: #b7c8dc;
	}

	.belief-heading h2 {
		margin: 0;
		color: #fff;
		font-size: clamp(54px, 7vw, 88px);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 0.98;
	}

	.belief-copy {
		max-width: 610px;
	}

	.belief-copy p {
		margin: 0;
		color: #e1e8f0;
		font-size: clamp(17px, 2vw, 21px);
		line-height: 1.7;
	}

	.belief-copy p + p {
		margin-top: 18px;
		color: #bdcce0;
		font-size: 15px;
	}

	.borders-section {
		padding: 96px 0 100px;
		background: #f4f7fb;
	}

	.borders-intro {
		max-width: 820px;
		margin-bottom: 38px;
	}

	.borders-intro > p:last-child {
		max-width: 740px;
	}

	.borders-intro > p:last-child + p {
		max-width: 740px;
		margin: 10px 0 0;
		color: var(--about-muted);
		font-size: 15px;
		line-height: 1.7;
	}

	.exhibition-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.exhibition-image {
		aspect-ratio: 3 / 2;
	}

	.exhibition-image figcaption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 40px 20px 17px;
		font-size: 14px;
		font-weight: 600;
	}

	.exhibition-image figcaption time {
		font-size: 12px;
		font-weight: 400;
	}

	.contact-cta {
		padding: 64px 0;
		background: var(--about-navy);
		color: #fff;
	}

	.contact-cta-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 48px;
	}

	.contact-cta .about-eyebrow {
		margin-bottom: 9px;
		color: #bdcce0;
	}

	.contact-cta h2 {
		margin: 0;
		color: #fff;
		font-size: clamp(30px, 3.5vw, 42px);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.15;
	}

	.contact-cta-inner > div > p:last-child {
		max-width: 700px;
		margin: 12px 0 0;
		color: #d3deeb;
		font-size: 15px;
		line-height: 1.7;
	}

	.contact-cta-button {
		min-height: 48px;
		flex: 0 0 auto;
		gap: 10px;
		background: #fff;
		color: var(--about-navy);
	}

	.contact-cta-button:hover:not(:disabled) {
		background: #e8eef5;
	}

	.contact-cta-button:focus-visible {
		outline-color: #fff;
	}

	@media (max-width: 1000px) {
		.story-layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
			gap: 40px;
		}

		.story-image {
			min-height: 0;
		}

		.company-facts > div {
			padding-inline: 10px;
		}

		.company-facts dt {
			font-size: 21px;
		}

	}

	@media (max-width: 700px) {
		.about-container {
			width: calc(100% - 40px);
		}

		.story-section {
			padding: 52px 0 58px;
		}

		.story-layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}

		.story-copy h1 {
			font-size: clamp(40px, 11vw, 54px);
		}

		.story-lead {
			margin-top: 20px;
			font-size: 17px;
		}

		.story-detail {
			font-size: 14px;
		}

		.company-facts {
			margin-top: 28px;
			padding-top: 18px;
		}

		.company-facts > div {
			padding-inline: 9px;
		}

		.company-facts dt {
			font-size: clamp(18px, 5vw, 23px);
		}

		.company-facts dd {
			margin-top: 5px;
			font-size: 10px;
		}

		.story-image {
			min-height: 0;
			aspect-ratio: 4 / 3;
		}

		.journey-section,
		.borders-section {
			padding: 64px 0 70px;
		}

		.section-intro {
			margin-bottom: 36px;
		}

		.section-intro h2 {
			font-size: clamp(32px, 8vw, 42px);
		}

		.section-intro > p:last-child {
			font-size: 14px;
		}

		.journey-item {
			grid-template-columns: 24px minmax(0, 1fr);
			column-gap: 16px;
			row-gap: 16px;
			padding: 0 0 32px;
		}

		.journey-list::before {
			top: 8px;
			bottom: 8px;
			left: 12px;
		}

		.journey-marker {
			grid-column: 1;
			grid-row: 1;
			align-self: start;
			justify-self: center;
			width: 17px;
			height: 17px;
		}

		.journey-copy,
		.journey-item.is-reversed .journey-copy {
			grid-column: 2;
			grid-row: 1;
			padding: 0;
		}

		.journey-image,
		.journey-item.is-reversed .journey-image {
			grid-column: 2;
			grid-row: 2;
		}

		.journey-date {
			font-size: 28px;
		}

		.journey-copy h3 {
			font-size: 19px;
		}

		.belief-section {
			padding: 68px 0 72px;
		}

		.belief-inner {
			grid-template-columns: minmax(0, 1fr);
