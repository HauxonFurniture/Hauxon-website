<script>
	function initializeHowWeWork() {
		const root = document.querySelector('.how-we-work');
		if (!root || root.dataset.interactionsReady === 'true') return;
		root.dataset.interactionsReady = 'true';

		const processButtons = Array.from(root.querySelectorAll('[data-process-step]'));
		const customTabs = Array.from(root.querySelectorAll('[data-custom-option]'));

		function selectProcessStep(index) {
			const activeIndex = (index + processButtons.length) % processButtons.length;
			const selectedButton = processButtons[activeIndex];
			processButtons.forEach((button, buttonIndex) => {
				const isActive = buttonIndex === activeIndex;
				button.classList.toggle('is-active', isActive);
				button.setAttribute('aria-pressed', String(isActive));
			});

			const updatePanel = () => {
				root.querySelector('#process-title').textContent = selectedButton.dataset.processTitle;
				root.querySelector('#process-description').textContent = selectedButton.dataset.processDescription;
				root.querySelector('#process-panel .step-kicker').textContent = `STEP ${String(activeIndex + 1).padStart(2, '0')} / ${String(processButtons.length).padStart(2, '0')}`;
				const image = root.querySelector('#process-image');
				image.src = selectedButton.dataset.processImage;
				image.alt = selectedButton.dataset.processAlt;
				for (let featureIndex = 0; featureIndex < 3; featureIndex += 1) {
					root.querySelector(`[data-process-feature-title="${featureIndex}"]`).textContent = selectedButton.getAttribute(`data-process-feature-title-${featureIndex}`);
					root.querySelector(`[data-process-feature-description="${featureIndex}"]`).textContent = selectedButton.getAttribute(`data-process-feature-description-${featureIndex}`);
				}
			};

			updatePanel();
		}

		function selectCustomOption(index) {
			const activeIndex = (index + customTabs.length) % customTabs.length;
			const selectedTab = customTabs[activeIndex];
			customTabs.forEach((tab, tabIndex) => {
				const isActive = tabIndex === activeIndex;
				tab.classList.toggle('is-active', isActive);
				tab.setAttribute('aria-selected', String(isActive));
				tab.setAttribute('tabindex', isActive ? '0' : '-1');
			});

			const updatePanel = () => {
				const panel = root.querySelector('#custom-panel');
				panel.setAttribute('aria-labelledby', selectedTab.id);
				root.querySelector('#custom-title').textContent = selectedTab.dataset.customTitle;
				root.querySelector('#custom-description').textContent = selectedTab.dataset.customDescription;
				const image = root.querySelector('#custom-image');
				image.src = selectedTab.dataset.customImage;
				image.alt = selectedTab.dataset.customAlt;
				for (let featureIndex = 0; featureIndex < 3; featureIndex += 1) {
					root.querySelector(`[data-custom-feature-title="${featureIndex}"]`).textContent = selectedTab.getAttribute(`data-custom-feature-title-${featureIndex}`);
					root.querySelector(`[data-custom-feature-description="${featureIndex}"]`).textContent = selectedTab.getAttribute(`data-custom-feature-description-${featureIndex}`);
				}
			};

			updatePanel();
		}

		root.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			const button = event.target.closest('button');
			if (!button || !root.contains(button)) return;

			if (button.matches('[data-process-step]')) {
				selectProcessStep(Number(button.dataset.processStep));
			} else if (button.matches('[data-process-prev], [data-process-next]')) {
				const activeIndex = processButtons.findIndex((item) => item.getAttribute('aria-pressed') === 'true');
				selectProcessStep(activeIndex + (button.matches('[data-process-next]') ? 1 : -1));
			} else if (button.matches('[data-custom-option]')) {
				selectCustomOption(Number(button.dataset.customOption));
			} else if (button.matches('[data-custom-prev], [data-custom-next]')) {
				const activeIndex = customTabs.findIndex((item) => item.getAttribute('aria-selected') === 'true');
				selectCustomOption(activeIndex + (button.matches('[data-custom-next]') ? 1 : -1));
			}
		});

		root.querySelector('[aria-label="OEM process steps"]')?.addEventListener('keydown', (event) => {
			if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
			const activeIndex = processButtons.findIndex((button) => button.getAttribute('aria-pressed') === 'true');
			let nextIndex = activeIndex;
			if (event.key === 'ArrowRight') nextIndex = (activeIndex + 1) % processButtons.length;
			if (event.key === 'ArrowLeft') nextIndex = (activeIndex - 1 + processButtons.length) % processButtons.length;
			if (event.key === 'Home') nextIndex = 0;
			if (event.key === 'End') nextIndex = processButtons.length - 1;
			if (nextIndex !== activeIndex) {
				event.preventDefault();
				processButtons[nextIndex].focus();
				selectProcessStep(nextIndex);
			}
		});

		root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
			if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
			event.preventDefault();
			const activeIndex = customTabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
			let nextIndex = activeIndex;
			if (event.key === 'ArrowRight') nextIndex = (activeIndex + 1) % customTabs.length;
			if (event.key === 'ArrowLeft') nextIndex = (activeIndex - 1 + customTabs.length) % customTabs.length;
			if (event.key === 'Home') nextIndex = 0;
			if (event.key === 'End') nextIndex = customTabs.length - 1;
			customTabs[nextIndex].focus();
			selectCustomOption(nextIndex);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeHowWeWork, { once: true });
	} else {
		initializeHowWeWork();
	}
</script>
