---
const countryOptions = [
	'China',
	'United States',
	'United Kingdom',
	'Canada',
	'Australia',
	'Germany',
	'France',
	'Italy',
	'Spain',
	'Netherlands',
	'Portugal',
	'Brazil',
	'India',
	'Japan',
	'South Korea',
	'Singapore',
	'United Arab Emirates',
	'Other',
];
---

<section class="contact-section" id="contact" aria-labelledby="contact-heading">
	<div class="contact-inner">
		<div class="contact-spacer" aria-hidden="true"></div>
		<div class="contact-copy">
			<span class="contact-accent" aria-hidden="true"></span>
			<h2 id="contact-heading">
				<span>Contact Us for</span>
				<span class="contact-highlight">Pricing and</span>
				<span>Custom Solutions</span>
			</h2>
			<p>
				Tell us your requirements and our team will get back to you with professional support as soon as possible.
			</p>
		</div>

		<form class="contact-form" data-contact-form novalidate>
			<div class="contact-fields">
				<label class="contact-field">
					<span>Name <span aria-hidden="true">*</span></span>
					<input name="name" type="text" autocomplete="name" placeholder="Your name" maxlength="100" required />
				</label>

				<label class="contact-field">
					<span>E-mail <span aria-hidden="true">*</span></span>
					<input name="email" type="email" autocomplete="email" placeholder="Your e-mail address" maxlength="254" required />
				</label>

				<label class="contact-field contact-field-full">
					<span>Phone / WhatsApp</span>
					<input name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" maxlength="30" />
				</label>

				<label class="contact-field contact-field-full">
					<span>Country <span aria-hidden="true">*</span></span>
					<select name="country" required>
						<option value="" selected disabled>Select your country</option>
						{countryOptions.map((country) => <option value={country}>{country}</option>)}
					</select>
				</label>

				<label class="contact-field contact-field-full">
					<span>Message <span aria-hidden="true">*</span></span>
					<textarea name="message" placeholder="Tell us about your requirements" maxlength="2000" required></textarea>
				</label>
			</div>

			<label class="contact-honeypot" aria-hidden="true">
				Leave this field empty
				<input name="website" type="text" tabindex="-1" autocomplete="off" />
			</label>
			<button class="contact-submit" type="submit">
				<span>Request a Quote</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
			</button>
			<p class="contact-status" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.contact-section {
		box-sizing: border-box;
		min-height: 700px;
		padding: 64px 0;
		display: flex;
		align-items: center;
		background-color: #edf2f8;
		background-image: url('/images/contact/contact-background.png');
		background-repeat: no-repeat;
		background-position: center center;
		background-size: cover;
		color: #18345b;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.contact-inner {
		box-sizing: border-box;
		width: min(calc(100% - 80px), 1360px);
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(250px, 1.05fr) minmax(310px, 1fr) minmax(420px, 1.25fr);
		align-items: center;
		gap: 32px;
	}

	.contact-copy {
		min-width: 0;
	}

	.contact-accent {
		width: 48px;
		height: 3px;
		margin-bottom: 24px;
		display: block;
		background: #4c80b8;
	}

	.contact-copy h2 {
		margin: 0;
		color: #18345b;
		font-size: clamp(36px, 3.1vw, 46px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.12;
	}

	.contact-copy h2 span {
		display: block;
	}

	.contact-copy h2 .contact-highlight {
		color: #4c80b8;
	}

	.contact-copy p {
		max-width: 400px;
		margin: 22px 0 0;
		color: #596a80;
		font-size: 17px;
		line-height: 1.65;
	}

	.contact-form {
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		padding: 32px;
		border-radius: 15px;
		background: rgb(255 255 255 / 96%);
		box-shadow: 0 12px 36px rgb(22 46 79 / 10%);
	}

	.contact-fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 16px;
	}

	.contact-field {
		min-width: 0;
		display: grid;
		gap: 8px;
		color: #283b56;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.3;
	}

	.contact-field > span > span {
		color: #4c80b8;
	}

	.contact-field-full {
		grid-column: 1 / -1;
	}

	.contact-field input,
	.contact-field select,
	.contact-field textarea {
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		height: 52px;
		padding: 0 14px;
		border: 1px solid #d8dee7;
		border-radius: 6px;
		background: #fbfcfe;
		color: #24364e;
		font: inherit;
		font-size: 14px;
		font-weight: 400;
		transition: border-color 160ms ease, background-color 160ms ease;
	}

	.contact-field input::placeholder,
	.contact-field textarea::placeholder {
		color: #8995a5;
		opacity: 1;
	}

	.contact-field input:focus,
	.contact-field select:focus,
	.contact-field textarea:focus {
		border-color: #4c80b8;
		background: #fff;
		outline: 2px solid rgb(76 128 184 / 16%);
		outline-offset: 1px;
	}

	.contact-field select:invalid {
		color: #8995a5;
	}

	.contact-field select option {
		color: #24364e;
	}

	.contact-field textarea {
		height: 116px;
		padding-block: 13px;
		resize: vertical;
	}

	.contact-submit {
		box-sizing: border-box;
		width: 214px;
		min-height: 50px;
		margin-top: 22px;
		padding: 0 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		border: 0;
		border-radius: 999px;
		background: #092e63;
		color: #fff;
		font: inherit;
		font-size: 15px;
		font-weight: 600;
		cursor: pointer;
		transition: background-color 180ms ease;
	}

	.contact-submit:hover:not(:disabled) {
		background: #164774;
	}

	.contact-submit:focus-visible {
		outline: 2px solid #092e63;
		outline-offset: 3px;
	}

	.contact-submit:disabled {
		opacity: 0.75;
		cursor: wait;
	}

	.contact-submit svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.contact-status {
		margin: 12px 0 0;
		color: #9b2c2c;
		font-size: 13px;
		line-height: 1.5;
	}

	.contact-status:empty {
		display: none;
	}

	.contact-status.is-success {
		color: #246b45;
	}

	.contact-honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	@media (max-width: 1100px) {
		.contact-section {
			min-height: 660px;
			background-position: 40% center;
		}

		.contact-inner {
			width: min(calc(75% - 32px), 900px);
			margin-left: max(24px, 25%);
			grid-template-columns: minmax(240px, 0.9fr) minmax(320px, 1.1fr);
			gap: 28px;
		}

		.contact-spacer {
			display: none;
		}

		.contact-copy h2 {
			font-size: 38px;
		}

		.contact-form {
			padding: 26px;
		}
	}

	@media (max-width: 900px) {
		.contact-section {
			min-height: 0;
			padding: 0 0 40px;
			display: block;
			background-color: #f3f6fa;
			background-position: left top;
			background-size: auto 250px;
		}

		.contact-inner {
			width: min(calc(100% - 40px), 680px);
			margin-inline: auto;
			padding-top: 230px;
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
		}

		.contact-copy h2 {
			font-size: 36px;
		}

		.contact-copy p {
			margin-top: 16px;
			font-size: 16px;
		}

		.contact-accent {
			margin-bottom: 18px;
		}

		.contact-form {
			padding: 22px;
			border-radius: 12px;
		}

		.contact-fields {
			grid-template-columns: minmax(0, 1fr);
			gap: 15px;
		}

		.contact-field-full {
			grid-column: auto;
		}

		.contact-submit {
			width: 100%;
		}
	}

	@media (max-width: 380px) {
		.contact-copy h2 {
			font-size: 32px;
		}

		.contact-form {
			padding: 18px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-field input,
		.contact-field select,
		.contact-field textarea,
		.contact-submit {
			transition: none;
		}
	}
</style>

<script>
	function initializeContactForm() {
		const form = document.querySelector<HTMLFormElement>('.contact-form');
		if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') return;
		form.dataset.ready = 'true';

		const button = form.querySelector<HTMLButtonElement>('.contact-submit');
		const buttonText = button?.querySelector<HTMLSpanElement>('span');
		const status = form.querySelector<HTMLElement>('.contact-status');
		if (!button || !buttonText || !status) return;
		let submitting = false;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (submitting) return;

			if (!form.reportValidity()) return;

			submitting = true;
			button.disabled = true;
			button.setAttribute('aria-busy', 'true');
			buttonText.textContent = 'Sending…';
			status.textContent = '';
			status.classList.remove('is-success');

			try {
				const formData = new FormData(form);
				const response = await fetch('/api/inquiry', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						name: String(formData.get('name') ?? '').trim(),
						email: String(formData.get('email') ?? '').trim(),
						phone: String(formData.get('phone') ?? '').trim(),
						country: String(formData.get('country') ?? '').trim(),
						message: String(formData.get('message') ?? '').trim(),
						website: String(formData.get('website') ?? '').trim(),
						source: 'contact',
					}),
				});
				const result: { success?: boolean } = await response.json();
				if (!response.ok || result.success !== true) throw new Error('Inquiry delivery failed.');

				form.reset();
				status.textContent = 'Thank you. Your inquiry has been sent to our team.';
				status.classList.add('is-success');
			} catch (error) {
				console.error('Unable to submit the Contact Us inquiry.', error);
				status.textContent = 'We couldn’t send your inquiry. Please try again.';
			} finally {
				buttonText.textContent = 'Request a Quote';
				button.disabled = false;
				button.removeAttribute('aria-busy');
				submitting = false;
			}
		});

		form.addEventListener('input', () => {
			if (status.textContent) status.textContent = '';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeContactForm, { once: true });
	} else {
		initializeContactForm();
	}
</script>
