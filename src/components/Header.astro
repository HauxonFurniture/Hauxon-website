---
const links = [
	{ label: 'Home', href: '#home' },
	{ label: 'Products', href: '#products' },
	{ label: 'OEM & ODM', href: '#oem-odm' },
	{ label: 'Manufacturing', href: '#manufacturing' },
	{ label: 'About Us', href: '#about' },
	{ label: 'Contact', href: '#contact' },
];
---

<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href="#home" aria-label="Hauxon home">
			<img src="/images/hauxon-logo.png" alt="Hauxon" />
		</a>

		<nav class="desktop-nav" aria-label="Main navigation">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<div class="header-actions">
			<button class="search-button" type="button" aria-label="Search">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="10.8" cy="10.8" r="6.3" />
					<path d="m15.5 15.5 4.2 4.2" />
				</svg>
			</button>
			<details class="language-selector">
				<summary aria-label="Language: English">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="9" />
						<path d="M3.5 12h17M12 3c2.3 2.5 3.4 5.5 3.4 9s-1.1 6.5-3.4 9c-2.3-2.5-3.4-5.5-3.4-9S9.7 5.5 12 3Z" />
					</svg>
					<span>EN</span>
				</summary>
				<div class="language-menu" aria-label="Choose a language">
					<div class="language-option is-selected" aria-current="true">
						<span>English</span><span class="language-status">Selected</span>
					</div>
					<button class="language-option" type="button" disabled>
						<span>Português</span><span class="language-status">Coming soon</span>
					</button>
					<button class="language-option" type="button" disabled>
						<span>Español</span><span class="language-status">Coming soon</span>
					</button>
				</div>
			</details>
			<a class="hauxon-button" href="#contact">Get a Quote</a>
			<details class="mobile-menu">
				<summary aria-label="Open navigation menu">
					<span></span><span></span>
				</summary>
				<nav aria-label="Mobile navigation">
					{links.map((link) => <a href={link.href}>{link.label}</a>)}
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background-color: #fff;
		border-bottom: 1px solid transparent;
		transition: background-color 250ms ease, backdrop-filter 250ms ease, border-color 250ms ease;
	}

	.site-header.is-scrolled {
		background-color: rgb(255 255 255 / 75%);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		border-bottom-color: #e8e8e5;
	}

	.header-inner {
		width: min(100% - 64px, 1440px);
		height: 64px;
		min-height: 64px;
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 28px;
		transition: height 250ms ease, min-height 250ms ease;
	}

	.site-header.is-scrolled .header-inner {
		height: 54px;
		min-height: 54px;
	}

	.wordmark {
		width: fit-content;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.wordmark img {
		display: block;
		width: 140px;
		height: auto;
		transition: width 250ms ease;
	}

	.site-header.is-scrolled .wordmark img {
		width: 128px;
	}

	.desktop-nav,
	.header-actions {
		display: flex;
		align-items: center;
	}

	.desktop-nav {
		gap: 30px;
	}

	.desktop-nav a {
		color: #252525;
		font-family: Helvetica, Arial, sans-serif;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.2px;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.mobile-menu nav a {
		color: #3a403c;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.desktop-nav a:hover,
	.mobile-menu nav a:hover {
		color: #003366;
	}

	.header-actions {
		justify-content: flex-end;
		gap: 12px;
	}

	.search-button {
		width: 40px;
		height: 40px;
		box-sizing: border-box;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 0;
		background: transparent;
		color: #252b27;
		cursor: pointer;
		transition: height 250ms ease;
	}

	.site-header.is-scrolled .search-button,
	.site-header.is-scrolled .language-selector summary {
		height: 34px;
	}

	.site-header.is-scrolled .search-button svg {
		width: 18px;
		height: 18px;
	}

	.site-header.is-scrolled .language-selector summary svg {
		width: 16px;
		height: 16px;
	}

	.search-button svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.6;
	}

	.language-selector {
		position: relative;
	}

	.language-selector summary {
		width: 40px;
		height: 40px;
		box-sizing: border-box;
		padding: 0;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
		color: #252b27;
		font-size: 11px;
		font-weight: 600;
		cursor: pointer;
		transition: height 250ms ease;
	}

	.language-selector summary::-webkit-details-marker {
		display: none;
	}

	.language-selector summary svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.language-selector summary > span {
		line-height: 1;
	}

	.language-menu {
		position: absolute;
		top: calc(100% + 12px);
		right: 0;
		width: 220px;
		padding: 6px 14px;
		background: #fff;
		border: 1px solid #e8e8e5;
		box-shadow: 0 12px 28px rgb(20 25 22 / 12%);
	}

	.language-option {
		width: 100%;
		min-height: 40px;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		border: 0;
		border-bottom: 1px solid #efefec;
		background: transparent;
		color: #3a403c;
		font: inherit;
		font-size: 13px;
		text-align: left;
	}

	.language-option:last-child {
		border-bottom: 0;
	}

	.language-option.is-selected {
		color: #003366;
		font-weight: 600;
	}

	.language-option:disabled {
		color: #707570;
		cursor: not-allowed;
	}

	.language-status {
		color: #777d78;
		font-size: 10px;
		font-weight: 400;
		white-space: nowrap;
	}

	.quote-button {
		min-height: 40px;
		padding: 0 18px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		background: #003366;
		color: #fff;
		font-family: Helvetica, Arial, sans-serif;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		transition: background 200ms ease, min-height 250ms ease;
	}

	.site-header.is-scrolled .quote-button {
		min-height: 34px;
	}

	.quote-button:hover {
		background: #164774;
	}
	.mobile-menu {
		display: none;
		position: relative;
	}

	.mobile-menu summary {
		width: 40px;
		height: 40px;
		aspect-ratio: 1;
		list-style: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 6px;
		border: 1px solid #dedfdb;
		cursor: pointer;
		transition: width 250ms ease, height 250ms ease;
	}

	.site-header.is-scrolled .mobile-menu summary {
		width: 34px;
		height: 34px;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu summary span {
		width: 17px;
		height: 1px;
		background: #252b27;
	}

	.mobile-menu nav {
		position: absolute;
		top: calc(100% + 20px);
		right: -12px;
		width: min(280px, calc(100vw - 32px));
		padding: 12px 20px;
		display: grid;
		background: #fff;
		border: 1px solid #e8e8e5;
		box-shadow: 0 16px 32px rgb(20 25 22 / 12%);
	}

	.mobile-menu nav a {
		padding-block: 13px;
		border-bottom: 1px solid #efefec;
	}

	.mobile-menu nav a:last-child {
		border-bottom: 0;
	}

	@media (max-width: 1080px) {
		.header-inner {
			width: min(100% - 40px, 1440px);
			gap: 18px;
		}

		.desktop-nav {
			gap: clamp(16px, 2vw, 22px);
		}

		.header-actions {
			gap: 10px;
		}
	}

	@media (max-width: 820px) {
		.header-inner {
			grid-template-columns: 1fr auto;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}
	}

	@media (max-width: 920px) {
		.header-inner {
			grid-template-columns: 1fr auto;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}
	}

	@media (max-width: 480px) {
		.header-inner {
			width: calc(100% - 32px);
		}

		.wordmark img {
			width: 132px;
		}

		.site-header.is-scrolled .wordmark img {
			width: 120px;
		}

		.header-actions {
			gap: 4px;
		}

		.search-button {
			width: 36px;
			height: 36px;
		}

		.search-button svg {
			width: 18px;
			height: 18px;
		}

		.language-selector summary {
			width: 36px;
			height: 36px;
			gap: 2px;
			font-size: 10px;
		}

		.language-selector summary svg {
			width: 16px;
			height: 16px;
		}

		.quote-button {
			min-height: 40px;
			padding-inline: 12px;
			gap: 7px;
			font-size: 12px;
		}

		.mobile-menu summary {
			width: 38px;
		}
	}
</style>

<script>
	const header = document.querySelector('.site-header');
	const updateHeaderOnScroll = () => {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	};

	window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
	updateHeaderOnScroll();
</script>