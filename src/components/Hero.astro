---
const slides = [
	{
		image: '/images/company/hauxon-factory.jpg',
		alt: 'Hauxon factory exterior',
	},
	{
		image: '/images/factory-hero.jpg',
		alt: 'Manufacturing equipment inside the Hauxon factory',
	},
	{
		image: '/images/how-we-work/oem-production.png',
		alt: 'Seating products being assembled during manufacturing',
	},
];
---

<section class="hero" aria-label="Hauxon manufacturing" aria-roledescription="carousel" data-hero-carousel>
	<div class="hero-backgrounds" aria-hidden="true">
		{slides.map((slide, index) => (
			<div
				class:list={['hero-slide', { 'is-active': index === 0 }]}
				data-hero-slide
			>
				<img class="hero-image" src={slide.image} alt="" fetchpriority={index === 0 ? 'high' : 'auto'} />
			</div>
		))}
	</div>
	<div class="hero-wash" aria-hidden="true"></div>
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="hero-eyebrow">Office Seating Manufacturer</p>
			<h1>Your Reliable Seating Manufacturing Partner</h1>
			<p class="hero-description">
				Hauxon is an office seating manufacturer based in Anji, China, with over 10 years of manufacturing experience. We provide reliable OEM &amp; ODM solutions for global brands, wholesalers, and distributors.
			</p>
			<div class="hero-actions">
				<a class="hero-button hero-button-primary" href="/#about">About Us</a>
				<a class="hero-button hero-button-secondary" href="/#oem-process-heading">Our Manufacturing</a>
			</div>
		</div>
	</div>

	<div class="hero-footer">
		<p class="hero-index" aria-live="polite" aria-atomic="true" data-hero-index>
			<span data-hero-current>01</span><span class="index-divider"> / </span>03
		</p>
		<div class="hero-controls" aria-label="Carousel controls">
			<button class="hero-control" type="button" aria-label="Previous slide" data-hero-previous>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
			</button>
			<button class="hero-control" type="button" aria-label="Next slide" data-hero-next>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
			</button>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: clamp(590px, 48vw, 710px);
		overflow: hidden;
		background: #f3f5f7;
		color: #172433;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.hero-backgrounds,
	.hero-slide {
		position: absolute;
		inset: 0;
	}

	.hero-slide {
		opacity: 0;
		transition: opacity 650ms ease;
	}

	.hero-slide.is-active {
		opacity: 1;
	}

	.hero-image,
	.hero-wash {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-image {
		display: block;
		object-fit: cover;
		object-position: center;
	}

	.hero-wash {
		background: linear-gradient(90deg, #f7f8fa 0%, rgb(247 248 250 / 98%) 27%, rgb(247 248 250 / 88%) 42%, rgb(247 248 250 / 40%) 59%, rgb(247 248 250 / 4%) 78%);
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: min(calc(100% - 64px), 1440px);
		height: 100%;
		margin-inline: auto;
		display: flex;
		align-items: center;
	}

	.hero-copy {
		width: min(52%, 650px);
		padding-block: 84px 104px;
	}

	.hero-eyebrow {
		margin: 0 0 22px;
		color: #0b2d5c;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	h1 {
		max-width: 700px;
		margin: 0;
		color: #172433;
		font-size: clamp(48px, 5.2vw, 72px);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1.04;
	}

	.hero-description {
		max-width: 530px;
		margin: 23px 0 0;
		color: #586574;
		font-size: 16px;
		line-height: 1.75;
	}

	.hero-actions {
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}

	.hero-button {
		min-height: 46px;
		padding: 0 20px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid #0b2d5c;
		border-radius: 4px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
	}

	.hero-button-primary {
		background: #0b2d5c;
		color: #fff;
	}

	.hero-button-primary:hover {
		border-color: #164774;
		background: #164774;
	}

	.hero-button-secondary {
		background: rgb(255 255 255 / 62%);
		color: #0b2d5c;
	}

	.hero-button-secondary:hover {
		background: #fff;
	}

	.hero-footer {
		position: absolute;
		z-index: 2;
		right: max(32px, calc((100vw - 1440px) / 2));
		bottom: 28px;
		left: max(32px, calc((100vw - 1440px) / 2));
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.hero-index {
		margin: 0;
		color: #647181;
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		letter-spacing: 1px;
	}

	.hero-index > span:first-child {
		color: #172433;
		font-weight: 600;
	}

	.hero-controls {
		display: flex;
		gap: 8px;
	}

	.hero-control {
		width: 42px;
		height: 42px;
		padding: 0;
		display: grid;
		place-items: center;
		border: 1px solid rgb(11 45 92 / 28%);
		border-radius: 50%;
		background: rgb(255 255 255 / 82%);
		color: #0b2d5c;
		cursor: pointer;
		transition: background-color 180ms ease, border-color 180ms ease;
	}

	.hero-control:hover {
		border-color: #0b2d5c;
		background: #fff;
	}

	.hero-control svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.hero-button:focus-visible,
	.hero-control:focus-visible {
		outline: 2px solid #0b2d5c;
		outline-offset: 3px;
	}

	@media (max-width: 900px) {
		.hero {
			min-height: 630px;
		}

		.hero-inner {
			width: min(calc(100% - 48px), 760px);
		}

		.hero-copy {
			width: min(66%, 560px);
		}

		.hero-wash {
			background: linear-gradient(90deg, #f7f8fa 0%, rgb(247 248 250 / 96%) 34%, rgb(247 248 250 / 77%) 58%, rgb(247 248 250 / 14%) 100%);
		}

		.hero-footer {
			right: 24px;
			left: 24px;
		}
	}

	@media (max-width: 600px) {
		.hero {
			min-height: min(720px, calc(100svh - 66px));
			min-height: max(620px, min(720px, calc(100svh - 66px)));
		}

		.hero-image {
			object-position: 62% center;
		}

		.hero-wash {
			background: linear-gradient(90deg, rgb(247 248 250 / 98%) 0%, rgb(247 248 250 / 91%) 54%, rgb(247 248 250 / 62%) 100%);
		}

		.hero-inner {
			width: calc(100% - 40px);
			align-items: flex-start;
		}

		.hero-copy {
			width: 100%;
			padding-block: 92px 100px;
		}

		.hero-eyebrow {
			margin-bottom: 18px;
			font-size: 10px;
			letter-spacing: 1.2px;
		}

		h1 {
			max-width: 500px;
			font-size: clamp(42px, 11vw, 58px);
		}

		.hero-description {
			max-width: 430px;
			margin-top: 18px;
			font-size: 15px;
			line-height: 1.65;
		}

		.hero-actions {
			margin-top: 24px;
			gap: 9px;
		}

		.hero-button {
			min-height: 44px;
			padding-inline: 14px;
			font-size: 12px;
		}

		.hero-footer {
			right: 20px;
			bottom: 18px;
			left: 20px;
		}

		.hero-control {
			width: 38px;
			height: 38px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-slide,
		.hero-button,
		.hero-control {
			transition: none;
		}
	}
</style>

<script>
	function initializeHeroCarousel() {
		const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
		if (!carousel || carousel.dataset.ready === 'true') return;
		carousel.dataset.ready = 'true';

		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-slide]'));
		const index = carousel.querySelector<HTMLElement>('[data-hero-index]');
		const currentIndex = carousel.querySelector<HTMLElement>('[data-hero-current]');
		const previous = carousel.querySelector<HTMLButtonElement>('[data-hero-previous]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-hero-next]');
		if (slides.length < 2 || !index || !currentIndex || !previous || !next) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let activeIndex = 0;
		let timer: number | undefined;
		let pausedByInteraction = false;

		function showSlide(nextIndex: number) {
			activeIndex = (nextIndex + slides.length) % slides.length;
			slides.forEach((slide, slideIndex) => {
				const active = slideIndex === activeIndex;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', String(!active));
				slide.inert = !active;
			});
			currentIndex.textContent = String(activeIndex + 1).padStart(2, '0');
		}

		function stopAutoplay() {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
		}

		function startAutoplay() {
			stopAutoplay();
			if (pausedByInteraction || reducedMotion.matches || document.hidden) return;
			timer = window.setInterval(() => showSlide(activeIndex + 1), 6000);
		}

		function pauseAfterInteraction() {
			pausedByInteraction = true;
			stopAutoplay();
		}

		previous.addEventListener('click', () => {
			pauseAfterInteraction();
			showSlide(activeIndex - 1);
		});
		next.addEventListener('click', () => {
			pauseAfterInteraction();
			showSlide(activeIndex + 1);
		});
		carousel.addEventListener('pointerdown', pauseAfterInteraction, { once: true });
		carousel.addEventListener('focusin', pauseAfterInteraction, { once: true });
		carousel.addEventListener('mouseenter', pauseAfterInteraction, { once: true });
		document.addEventListener('visibilitychange', startAutoplay);
		reducedMotion.addEventListener('change', startAutoplay);
		showSlide(0);
		startAutoplay();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeHeroCarousel, { once: true });
	} else {
		initializeHeroCarousel();
	}
</script>
