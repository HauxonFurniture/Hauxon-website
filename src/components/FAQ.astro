---
interface Props {
	showAll?: boolean;
}

const { showAll = false } = Astro.props;

const faqs = [
	{
		question: 'Are you a manufacturer or a trading company? Where is your factory located?',
		answer: 'We are a seating manufacturer based in Anji, Zhejiang, China.',
	},
	{
		question: 'What is your minimum order quantity (MOQ)?',
		answer: 'Our MOQ depends on specific product models and customization requirements. Please contact us for a detailed quotation.',
	},
	{
		question: 'Can I order a sample before mass production?',
		answer: 'Yes, samples are available. Sample cost and shipping fees will be confirmed separately before arrangement.',
	},
	{
		question: 'How do you ensure product quality?',
		answer: 'We carry out inspections during each production process and conduct final checks before shipment to control product quality.',
	},
	{
		question: 'What is your production lead time?',
		answer: 'The lead time varies based on order quantity and customization details. We will confirm the schedule after order confirmation.',
	},
	{
		question: 'Can you customize packaging?',
		answer: 'Yes, customized packaging is acceptable. Relevant costs will be quoted according to your requirements.',
	},
	{
		question: 'What quality certifications do you hold?',
		answer: 'Our products can meet mainstream international testing standards. Relevant certification documents can be provided upon request.',
	},
	{
		question: 'What warranty and after-sales support do you provide?',
		answer: 'We provide after-sales support for quality-related issues. Specific warranty terms can be discussed based on formal orders.',
	},
];

const visibleFaqs = showAll ? faqs : faqs.slice(0, 5);
---

<section class="faq-section" aria-labelledby="faq-heading">
	<div class="faq-inner">
		<div class="faq-layout">
			<div class="faq-intro">
				<p class="faq-kicker">FAQ</p>
				<h2 id="faq-heading">Frequently Asked Questions</h2>
				<p class="faq-description">
					Find quick answers to common questions about our products, customization options, production and shipping.
				</p>
			</div>

			<div class="faq-content">
				<div class="faq-list">
					{visibleFaqs.map((faq, index) => (
						<article class:list={['faq-item', { 'is-open': index === 0 }]}>
							<button
								class="faq-question"
								type="button"
								id={`faq-question-${index + 1}`}
								aria-expanded={index === 0 ? 'true' : 'false'}
								aria-controls={`faq-answer-${index + 1}`}
							>
								<span class="faq-number">{String(index + 1).padStart(2, '0')}</span>
								<span class="faq-question-text">{faq.question}</span>
								<span class="faq-toggle" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path class="faq-toggle-vertical" d="M12 5v14" />
										<path d="M5 12h14" />
									</svg>
								</span>
							</button>
							<div
								class="faq-answer"
								id={`faq-answer-${index + 1}`}
								role="region"
								aria-labelledby={`faq-question-${index + 1}`}
								aria-hidden={index === 0 ? 'false' : 'true'}
							>
								<div class="faq-answer-inner">
									<p>{faq.answer}</p>
								</div>
							</div>
						</article>
					))}
				</div>

				{!showAll && (
					<a class="faq-more-link" href="/faq/">
						View More FAQs
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
					</a>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.faq-section {
		box-sizing: border-box;
		padding: 80px 0;
		background: #f4f7fb;
		color: #111827;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.faq-inner {
		width: min(calc(100% - 48px), 1360px);
		margin-inline: auto;
	}

	.faq-layout {
		display: grid;
		grid-template-columns: minmax(0, 40fr) minmax(0, 60fr);
		align-items: center;
		gap: 72px;
	}

	.faq-intro,
	.faq-content {
		min-width: 0;
	}

	.faq-intro {
		max-width: 500px;
	}

	.faq-kicker {
		margin: 0 0 18px;
		color: #0b315f;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.2em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.faq-intro h2 {
		margin: 0;
		color: #111e32;
		font-size: clamp(36px, 3.1vw, 46px);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.08;
	}

	.faq-description {
		max-width: 45ch;
		margin: 22px 0 0;
		color: #64748b;
		font-size: 18px;
		line-height: 1.65;
	}

	.faq-list {
		display: grid;
	}

	.faq-item {
		min-width: 0;
		border-bottom: 1px solid #dce5ef;
		border-radius: 0;
		transition: background-color 200ms ease, border-radius 200ms ease;
	}

	.faq-item:not(.is-open):hover {
		background: #eff4fa;
	}

	.faq-item.is-open {
		border-bottom-color: transparent;
		border-radius: 10px;
		background: #edf4fb;
	}

	.faq-question {
		box-sizing: border-box;
		width: 100%;
		min-height: 76px;
		padding: 14px 18px;
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr) 42px;
		align-items: center;
		gap: 18px;
		border: 0;
		border-radius: inherit;
		background: transparent;
		color: #0b315f;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.faq-number {
		color: #6fa1dc;
		font-size: 18px;
		font-weight: 700;
		line-height: 1.3;
	}

	.faq-question-text {
		font-size: 17px;
		font-weight: 700;
		line-height: 1.45;
	}

	.faq-toggle {
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #e5eef8;
		color: #0b315f;
	}

	.faq-toggle svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.8;
	}

	.faq-toggle-vertical {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 200ms ease;
	}

	.faq-item.is-open .faq-toggle-vertical {
		transform: scaleY(0);
	}

	.faq-answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 250ms ease;
	}

	.faq-answer-inner {
		min-height: 0;
		overflow: hidden;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.faq-answer-inner p {
		margin: 0;
		padding: 0 78px 22px 106px;
		color: #64748b;
		font-size: 15px;
		line-height: 1.6;
	}

	.faq-item.is-open .faq-answer {
		grid-template-rows: 1fr;
	}

	.faq-item.is-open .faq-answer-inner {
		opacity: 1;
	}

	.faq-more-link {
		width: fit-content;
		margin: 34px 0 0 12px;
		display: inline-flex;
		align-items: center;
		gap: 16px;
		color: #0b315f;
		font-size: 15px;
		font-weight: 500;
		line-height: 1.4;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.faq-more-link:hover {
		color: #527da9;
	}

	.faq-more-link svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
		transition: transform 180ms ease;
	}

	.faq-more-link:hover svg {
		transform: translateX(3px);
	}

	.faq-question:focus-visible,
	.faq-more-link:focus-visible {
		outline: 2px solid #0b315f;
		outline-offset: 3px;
	}

	@media (max-width: 1050px) {
		.faq-layout {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			gap: 40px;
		}

		.faq-intro h2 {
			font-size: 36px;
		}

		.faq-description {
			font-size: 16px;
		}

		.faq-question {
			grid-template-columns: 42px minmax(0, 1fr) 38px;
			gap: 12px;
			padding-inline: 14px;
		}

		.faq-toggle {
			width: 38px;
			height: 38px;
		}

		.faq-answer-inner p {
			padding-right: 56px;
			padding-left: 68px;
		}
	}

	@media (max-width: 760px) {
		.faq-section {
			padding: 56px 0;
		}

		.faq-inner {
			width: calc(100% - 40px);
		}

		.faq-layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 30px;
		}

		.faq-kicker {
			margin-bottom: 12px;
		}

		.faq-intro h2 {
			font-size: 32px;
		}

		.faq-description {
			margin-top: 16px;
			font-size: 16px;
		}

		.faq-question {
			min-height: 68px;
			grid-template-columns: 34px minmax(0, 1fr) 34px;
			gap: 10px;
			padding: 12px 10px;
		}

		.faq-question-text {
			font-size: 15px;
		}

		.faq-number {
			font-size: 16px;
		}

		.faq-toggle {
			width: 34px;
			height: 34px;
		}

		.faq-answer-inner p {
			padding: 0 18px 18px 54px;
			font-size: 14px;
		}

		.faq-more-link {
			margin: 26px 0 0 8px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item,
		.faq-toggle-vertical,
		.faq-answer,
		.faq-answer-inner,
		.faq-more-link,
		.faq-more-link svg {
			transition: none;
		}
	}
</style>

<script>
	function initializeFaq() {
		const section = document.querySelector('.faq-section');
		if (!section || section.dataset.interactionsReady === 'true') return;
		section.dataset.interactionsReady = 'true';

		const questions = Array.from(section.querySelectorAll('.faq-question'));

		section.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			const selectedQuestion = event.target.closest('.faq-question');
			if (!selectedQuestion || !section.contains(selectedQuestion)) return;
			const shouldOpen = selectedQuestion.getAttribute('aria-expanded') !== 'true';

			questions.forEach((question) => {
				const isOpen = question === selectedQuestion && shouldOpen;
				question.setAttribute('aria-expanded', String(isOpen));
				const answer = section.querySelector(`#${question.getAttribute('aria-controls')}`);
				answer.setAttribute('aria-hidden', String(!isOpen));
				question.closest('.faq-item').classList.toggle('is-open', isOpen);
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeFaq, { once: true });
	} else {
		initializeFaq();
	}
</script>
