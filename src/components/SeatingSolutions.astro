---
import { productCategories } from '../data/products';

const categoryDescriptions: Record<string, string> = {
	'office-chair': 'Ergonomic and professional seating for modern workplaces.',
	'leisure-chair': 'Comfortable and stylish seating for versatile spaces.',
	'bar-stool': 'Functional seating solutions for counters and high tables.',
	'specialty-chair': 'Purpose-built seating for specialized working environments.',
};

const categoryImages: Record<string, string> = {
	'office-chair': '/images/categories/hauxon-office-chair.jpg',
	'leisure-chair': '/images/categories/hauxon-leisure-chair.jpg',
	'bar-stool': '/images/categories/hauxon-bar-stool.jpg',
	'specialty-chair': '/images/categories/hauxon-specialty-chair.jpg',
};

const categories = productCategories
	.filter((category) => categoryImages[category.id])
	.map((category) => ({
		...category,
		description: categoryDescriptions[category.id],
		image: categoryImages[category.id],
		route: `/products#${category.id}`,
	}));
---

<section class="seating-solutions" aria-labelledby="solutions-title">
	<div class="section-inner">
		<header class="section-heading">
			<div class="heading-copy">
				<p class="section-kicker">Seating Solutions</p>
				<h2 id="solutions-title">A Complete Range of Seating Solutions</h2>
			</div>
			<div class="heading-intro">
				<p>
					Explore our office chairs, leisure chairs, bar stools, and specialty seating, manufactured with flexible OEM &amp; ODM capabilities.
				</p>
				<a class="explore-products" href="/products">
					Explore All Solutions
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
				</a>
			</div>
		</header>

		<div class="solutions-grid">
			{categories.map((category) => (
				<article class="solution-card">
					<a class="image-frame" href={category.route} aria-label={`View ${category.name} products`}>
						<img src={category.image} alt={`${category.name} seating`} loading="lazy" />
						<span class="category-icon" aria-hidden="true">
							{category.id === 'office-chair' && (
								<svg viewBox="0 0 32 32"><path d="M11 5v9a4 4 0 0 0 4 4h7M9 14h13a3 3 0 0 1 3 3v2H11a4 4 0 0 1-4-4v-1M10 19l-2 8m14-8 2 8M7 23h18" /></svg>
							)}
							{category.id === 'leisure-chair' && (
								<svg viewBox="0 0 32 32"><path d="M8 17v-5a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v5M6 17h20l-2 6H8l-2-6Zm4 6v4m12-4v4" /></svg>
							)}
							{category.id === 'bar-stool' && (
								<svg viewBox="0 0 32 32"><path d="M10 5h12l-1 7H11l-1-7Zm6 7v11m-7 0h14m-12 0-2 4m12-4 2 4" /></svg>
							)}
							{category.id === 'specialty-chair' && (
								<svg viewBox="0 0 32 32"><path d="M11 5v8a4 4 0 0 0 4 4h8v3H11a4 4 0 0 1-4-4v-3m18 7-2 7m-12-7-2 7m-4-4h19" /></svg>
							)}
						</span>
					</a>
					<div class="solution-content">
						<h3>{category.name}</h3>
						<p>{category.description}</p>
						<a class="view-products" href={category.route}>
							View Products
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.seating-solutions {
		padding: clamp(58px, 6vw, 76px) 0;
		background: #f4f7fb;
		color: #111827;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.section-inner {
		width: min(calc(100% - 64px), 1360px);
		margin-inline: auto;
	}

	.section-heading {
		margin-bottom: 42px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
		align-items: end;
		gap: 64px;
	}

	.section-kicker {
		margin: 0 0 16px;
		color: #0b315f;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.2em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	h2 {
		max-width: 600px;
		margin: 0;
		color: #111e32;
		font-size: clamp(36px, 3.1vw, 46px);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.08;
	}

	.heading-intro {
		padding-bottom: 3px;
	}

	.heading-intro p {
		margin: 0;
		color: #64748b;
		font-size: 17px;
		line-height: 1.65;
	}

	.explore-products {
		width: fit-content;
		margin-top: 18px;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 11px 16px;
		border-radius: 4px;
		background: #0b2d5c;
		color: #fff;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}

	.explore-products svg,
	.view-products svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
		transition: transform 180ms ease;
	}

	.explore-products:hover svg,
	.view-products:hover svg {
		transform: translateX(3px);
	}

	.explore-products:hover {
		background: #164774;
	}

	.solutions-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
	}

	.solution-card {
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.image-frame {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		display: grid;
		place-items: center;
		border-radius: 6px;
		background: #e8edf3;
	}

	.image-frame img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: contain;
		transition: transform 300ms ease;
	}

	.image-frame:hover img {
		transform: scale(1.03);
	}

	.solution-content {
		flex: 1;
		padding-top: 18px;
		display: flex;
		flex-direction: column;
	}

	.category-icon {
		position: absolute;
		bottom: 20px;
		left: 20px;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		color: #0b315f;
		border-radius: 10px;
		background: rgb(255 255 255 / 78%);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		transition: background-color 300ms ease;
	}

	.image-frame:hover .category-icon {
		background: rgb(255 255 255 / 92%);
	}

	.category-icon svg {
		width: 21px;
		height: 21px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.25;
	}

	h3 {
		margin: 0;
		color: #111e32;
		font-size: 18px;
		font-weight: 600;
		line-height: 1.4;
	}

	.solution-content > p {
		flex: 1;
		margin: 10px 0 0;
		color: #64748b;
		font-size: 14px;
		line-height: 1.6;
	}

	.view-products {
		width: fit-content;
		margin-top: 18px;
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: #0b315f;
		font-size: 13px;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.view-products:hover,
	.explore-products:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.explore-products:focus-visible,
	.view-products:focus-visible,
	.image-frame:focus-visible {
		outline: 2px solid #0b315f;
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.section-heading {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 0.82fr);
			gap: 36px;
		}

		.solutions-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 36px 24px;
		}
	}

	@media (max-width: 650px) {
		.seating-solutions {
			padding: 64px 0 72px;
		}

		.section-inner {
			width: calc(100% - 40px);
		}

		.section-heading {
			margin-bottom: 30px;
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
		}

		h2 {
			max-width: 480px;
			font-size: 36px;
		}

		.heading-intro p {
			font-size: 16px;
		}

		.solutions-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}

		.solution-content {
			padding-top: 12px;
		}

		.solution-content > p {
			min-height: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.image-frame img,
		.category-icon,
		.explore-products svg,
		.view-products svg {
			transition: none;
		}
	}
</style>
