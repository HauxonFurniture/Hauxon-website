---
const categories = [
	{
		title: 'Office Chair',
		description: 'Ergonomic and professional seating for modern workplaces.',
		image: '/images/categories/hauxon-office-chair.jpg',
		route: '/products#office-chair',
	},
	{
		title: 'Leisure Chair',
		description: 'Comfortable and stylish seating for versatile spaces.',
		image: '/images/categories/hauxon-leisure-chair.jpg',
		route: '/products#leisure-chair',
	},
	{
		title: 'Bar Stool',
		description: 'Functional seating solutions for counters and high tables.',
		image: '/images/categories/hauxon-bar-stool.jpg',
		route: '/products#bar-stool',
	},
	{
		title: 'Specialty Chair',
		description: 'Purpose-built seating for specialized working environments.',
		image: '/images/categories/hauxon-specialty-chair.jpg',
		route: '/products#specialty-chair',
	},
];
---

<section class="seating-solutions" aria-labelledby="solutions-title">
	<div class="section-inner">
		<header class="section-heading">
			<p class="section-kicker">Hauxon Seating</p>
			<h2 id="solutions-title">Our Seating Solutions</h2>
			<p class="section-subtitle">
				Explore our range of seating solutions, designed for global brands, wholesalers and commercial projects.
			</p>
		</header>

		<div class="solutions-grid">
			{categories.map((category) => (
				<article class="solution-item">
					<div class="image-frame">
						<img src={category.image} alt={category.title} loading="lazy" />
					</div>
					<div class="solution-content">
						<h3>{category.title}</h3>
						<p>{category.description}</p>
						<a class="view-products" href={category.route}>
							View Products <span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.seating-solutions {
		box-sizing: border-box;
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(64px, 7vh, 88px) 0;
		display: flex;
		align-items: center;
		background: #f7f8f8;
		color: #252b27;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.section-inner {
		width: min(100% - 64px, 1440px);
		margin-inline: auto;
	}

	.section-heading {
		max-width: 700px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-kicker {
		margin: 0 0 12px;
		color: #003366;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.2px;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		color: #202722;
		font-size: clamp(32px, 3.4vw, 44px);
		font-weight: 600;
		line-height: 1.15;
	}

	.section-subtitle {
		max-width: 620px;
		margin: 16px auto 0;
		color: #626a65;
		font-size: 16px;
		line-height: 1.65;
	}

	.solutions-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: stretch;
		gap: 24px;
	}

	.solution-item {
		min-width: 0;
		min-height: clamp(460px, 30vw, 560px);
		display: flex;
		flex-direction: column;
	}

	.image-frame {
		width: 100%;
		max-width: 285px;
		aspect-ratio: 4 / 5;
		margin-inline: auto;
		overflow: hidden;
		background: #fff;
		border-radius: 12px;
	}

	.image-frame img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		transition: transform 300ms ease;
	}

	.solution-item:hover .image-frame img {
		transform: scale(1.015);
	}

	.solution-content {
		flex: 1;
		width: 100%;
		padding: 20px 0 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	h3 {
		margin: 0;
		color: #242a26;
		font-size: 22px;
		font-weight: 600;
		line-height: 1.3;
	}

	.solution-content > p {
		min-height: 54px;
		margin: 12px 0 22px;
		color: #68716c;
		font-size: 15px;
		line-height: 1.6;
	}

	.view-products {
		margin-top: auto;
		align-self: center;
		padding-block: 8px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		color: #003366;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.4;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.view-products span {
		display: inline-block;
		transition: transform 180ms ease;
	}

	.view-products:hover:not(:disabled) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.view-products:hover span {
		transform: translateX(3px);
	}

	.view-products:disabled {
		padding-inline: 0;
		border: 0;
		background: transparent;
		cursor: not-allowed;
	}

	@media (max-width: 980px) {
		.section-inner {
			width: min(100% - 48px, 1280px);
		}
	}

	@media (max-width: 900px) {
		.section-inner {
			width: min(100% - 48px, 760px);
		}

		.solutions-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 20px;
		}

		.solution-item {
			min-height: 0;
		}
	}

	@media (max-width: 600px) {
		.seating-solutions {
			padding: 64px 0 72px;
		}

		.section-inner {
			width: calc(100% - 36px);
		}

		.section-heading {
			margin-bottom: 32px;
		}

		h2 {
			font-size: 32px;
		}

		.section-subtitle {
			font-size: 15px;
		}

		.solutions-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 18px;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.solution-item,
		.image-frame img,
		.view-products {
			transition: none;
		}

		.solution-item:hover .image-frame img,
		.view-products:hover span {
			transform: none;
		}
	}
</style>