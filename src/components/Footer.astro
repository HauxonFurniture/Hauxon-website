---
const quickLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Products', href: '/products' },
	{ label: 'About Us', href: '#about' },
	{ label: 'Contact Us', href: '#contact' },
	{ label: 'FAQ', href: '/faq/' },
];

const categories = [
	{ label: 'Office Chair', href: '/products#office-chair' },
	{ label: 'Leisure Chair', href: '/products#leisure-chair' },
	{ label: 'Bar Stool', href: '/products#bar-stool' },
	{ label: 'Specialty Chair', href: '/products#specialty-chair' },
	{ label: 'Accessory', href: '/products#accessory' },
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-columns">
			<nav class="footer-column" aria-labelledby="footer-quick-links">
				<h2 id="footer-quick-links">Quick Links</h2>
				<ul class="footer-link-list">
					{quickLinks.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</nav>

			<nav class="footer-column" aria-labelledby="footer-categories">
				<h2 id="footer-categories">Categories</h2>
				<ul class="footer-link-list">
					{categories.map((category) => (
						<li><a href={category.href}>{category.label}</a></li>
					))}
				</ul>
			</nav>

			<section class="footer-column footer-contact" aria-labelledby="footer-contact-heading">
				<h2 id="footer-contact-heading">Contact Us</h2>
				<div class="contact-list">
					<div class="contact-item">
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
						</span>
						<p>
							<strong>Anji Huaxuan Furniture Co., Ltd.</strong>
							<span>Yishita Common Prosperity Industrial Park,<br />Dipu St, Anji, Huzhou, Zhejiang, China</span>
						</p>
					</div>
					<div class="contact-item">
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M21 16.4v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 1.1 3.7 2 2 0 0 1 3.1 1.5h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7 9.5a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" /></svg>
						</span>
						<p>
							<a class="contact-primary" href="tel:+8615068881647">+86 15068881647</a>
							<a class="contact-secondary" href="https://wa.me/8615068881647" target="_blank" rel="noopener noreferrer">Phone / WhatsApp</a>
						</p>
					</div>
					<div class="contact-item">
						<span class="contact-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
						</span>
						<p>
							<a class="contact-primary" href="mailto:sales@hxchairs.com">sales@hxchairs.com</a>
							<span>Email</span>
						</p>
					</div>
				</div>
			</section>

			<section class="footer-column footer-newsletter" aria-labelledby="footer-newsletter-heading">
				<h2 id="footer-newsletter-heading">Let’s Keep in Touch</h2>
				<p class="newsletter-description">
					Leave your email and our team will be in touch. This is not a marketing subscription.
				</p>
				<form class="newsletter-form" data-footer-inquiry-form aria-label="Contact request">
					<label class="visually-hidden" for="footer-email">E-mail</label>
					<input id="footer-email" name="email" type="email" placeholder="E-mail" maxlength="254" autocomplete="email" required aria-describedby="subscription-note" />
					<button type="submit" aria-label="Send contact request">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
					</button>
					<label class="footer-honeypot" aria-hidden="true">
						Leave this field empty
						<input name="website" type="text" tabindex="-1" autocomplete="off" />
					</label>
				</form>
				<p class="subscription-note" id="subscription-note" data-footer-inquiry-status role="status" aria-live="polite"></p>
			</section>
		</div>

		<div class="footer-bottom">
			<p class="copyright">© 2026 Anji Huaxuan Furniture Co., Ltd. All Rights Reserved.</p>
			<div class="footer-legal" aria-label="Legal and social links">
				<span>Privacy Policy</span>
				<span class="legal-separator" aria-hidden="true">|</span>
				<span>Terms of Use</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		box-sizing: border-box;
		border-top: 1px solid #e5e7eb;
		background: #fff;
		color: #111827;
		font-family: Helvetica, 'Helvetica Neue', Arial, sans-serif;
	}

	.footer-inner {
		width: min(calc(100% - 64px), 1440px);
		margin-inline: auto;
	}

	.footer-columns {
		padding: 64px 0 48px;
		display: grid;
		grid-template-columns: 17fr 19fr 34fr 30fr;
		gap: 32px;
	}

	.footer-column {
		min-width: 0;
	}

	.footer-column h2 {
		margin: 0 0 28px;
		color: #111827;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.35;
	}

	.footer-link-list {
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
		list-style: none;
	}

	.footer-link-list a,
	.contact-item a {
		text-decoration: none;
		transition: color 180ms ease;
	}

	.footer-link-list a {
		color: #64748b;
		font-size: 14px;
		font-weight: 400;
		line-height: 1.4;
	}

	.footer-link-list a:hover,
	.contact-item a:hover {
		color: #0b2d5c;
	}

	.contact-list {
		display: grid;
		gap: 20px;
	}

	.contact-item {
		min-width: 0;
		display: grid;
		grid-template-columns: 38px minmax(0, 1fr);
		align-items: start;
		gap: 12px;
	}

	.contact-icon {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #f1f5f9;
		color: #0b2d5c;
	}

	.contact-icon svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.contact-item p {
		min-width: 0;
		margin: 1px 0 0;
		display: grid;
		gap: 5px;
		color: #64748b;
		font-size: 13px;
		line-height: 1.55;
	}

	.contact-item strong,
	.contact-primary {
		color: #111827;
		font-size: 14px;
		font-weight: 500;
		line-height: 1.45;
	}

	.contact-secondary {
		width: fit-content;
		color: #64748b;
		font-size: 13px;
		line-height: 1.4;
	}

	.newsletter-description {
		margin: 0 0 20px;
		color: #64748b;
		font-size: 14px;
		line-height: 1.65;
	}

	.newsletter-form {
		position: relative;
		width: 100%;
	}

	.newsletter-form input {
		box-sizing: border-box;
		width: 100%;
		height: 46px;
		padding: 0 58px 0 16px;
		border: 1px solid #d9dee5;
		border-radius: 6px;
		background: #fff;
		color: #64748b;
		font: inherit;
		font-size: 14px;
	}

	.newsletter-form input::placeholder {
		color: #64748b;
		opacity: 1;
	}

	.newsletter-form input:focus {
		border-color: #0b2d5c;
		outline: 2px solid rgb(11 45 92 / 12%);
		outline-offset: 1px;
	}

	.newsletter-form button {
		position: absolute;
		top: 3px;
		right: 3px;
		width: 40px;
		height: 40px;
		padding: 0;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: #0b2d5c;
		color: #fff;
	}

	.newsletter-form button svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
	}

	.newsletter-form button:disabled {
		opacity: 0.72;
		cursor: not-allowed;
	}

	.newsletter-form button:not(:disabled) {
		cursor: pointer;
	}

	.newsletter-form button:not(:disabled):hover {
		background: #164774;
	}

	.footer-honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.subscription-note.is-success {
		color: #246b45;
	}

	.subscription-note {
		margin: 8px 0 0;
		color: #64748b;
		font-size: 12px;
		line-height: 1.5;
	}

	.footer-bottom {
		min-height: 64px;
		padding: 16px 0;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		border-top: 1px solid #e5e7eb;
	}

	.copyright,
	.footer-legal {
		margin: 0;
		color: #64748b;
		font-size: 12px;
		font-weight: 400;
		line-height: 1.6;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 12px;
		white-space: nowrap;
	}

	.legal-separator {
		color: #cbd5e1;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1050px) {
		.footer-columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 44px 40px;
		}
	}

	@media (max-width: 640px) {
		.footer-inner {
			width: min(calc(100% - 40px), 480px);
		}

		.footer-columns {
			padding: 48px 0 36px;
			grid-template-columns: minmax(0, 1fr);
			gap: 36px;
		}

		.footer-column h2 {
			margin-bottom: 20px;
		}

		.footer-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}

		.footer-legal {
			flex-wrap: wrap;
			white-space: normal;
		}
	}
</style>

<script>
	function initializeFooterInquiry() {
		const form = document.querySelector<HTMLFormElement>('[data-footer-inquiry-form]');
		const status = document.querySelector<HTMLElement>('[data-footer-inquiry-status]');
		const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (!form || !status || !button || form.dataset.ready === 'true') return;
		form.dataset.ready = 'true';
		let submitting = false;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (submitting || !form.reportValidity()) return;
			submitting = true;
			button.disabled = true;
			button.setAttribute('aria-busy', 'true');
			status.classList.remove('is-success');
			status.textContent = 'Sending…';

			try {
				const formData = new FormData(form);
				const response = await fetch('/api/footer-contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						email: String(formData.get('email') ?? '').trim(),
						website: String(formData.get('website') ?? '').trim(),
					}),
				});
				const result: { success?: boolean } = await response.json();
				if (!response.ok || result.success !== true) throw new Error('Footer contact request failed.');
				form.reset();
				status.textContent = 'Thank you. Our team will be in touch.';
				status.classList.add('is-success');
			} catch (error) {
				console.error('Unable to submit the footer contact request.', error);
				status.textContent = 'We couldn’t send your email. Please try again.';
			} finally {
				button.disabled = false;
				button.removeAttribute('aria-busy');
				submitting = false;
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeFooterInquiry, { once: true });
	} else {
		initializeFooterInquiry();
	}
</script>
